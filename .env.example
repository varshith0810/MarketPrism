# =====================================================================
# MarketPrism Configuration
# =====================================================================

# NVIDIA NIM / OpenAI-compatible API Configuration
# Get your API key at https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# Optional: Custom endpoint URL (defaults to NVIDIA NIM API Catalog)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: Model name (defaults to nvidia/nemotron-3.5-lightning-30b-a3b)
MODEL_NAME=nvidia/nemotron-3.5-lightning-30b-a3b

# Optional: Model temperature (defaults to 0.2 for instruct/tool execution)
MODEL_TEMPERATURE=0.2

# Langfuse Observability & Tracing (Optional)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
